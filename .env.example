# Tuya bulb local MCP — the wizard creates .env; values below are examples.
# .env is gitignored: never commit real keys.

# Device identity (from a TinyTuya LAN scan: python -m tinytuya scan)
TUYA_BULB_DEVICE_ID=YOUR_DEVICE_ID
TUYA_BULB_IP=192.0.2.10
TUYA_BULB_VERSION=3.3

# Local key (from the Tuya IoT Cloud, one-time fetch). Keep secret.
TUYA_BULB_LOCAL_KEY=

# Optional hard guard: if set, the server refuses to start unless
# TUYA_BULB_DEVICE_ID matches this value (protects against a wrong .env).
# TUYA_BULB_EXPECTED_DEVICE_ID=
